# bedrock-compare.awskr.net -- served by this stack's distribution E43RB5R0916YO
# (plan + web ACL + code-managed distribution). The old pay-as-you-go distribution has been retired.
# The bucket stays in ap-northeast-2; its bucket policy and the deploy role are updated by hand,
# see aws-whats-new-korean/infra/README.md.
# AttachAlias is true now that the cutover is complete.
StackName=awskr-site-bedrock-compare
SiteName=bedrock-compare
DomainName=bedrock-compare.awskr.net
AttachAlias=true
ManageDnsRecords=false
CreateBucket=false
BucketName=awskr-bedrock-pricing
BucketRegion=ap-northeast-2
UrlMode=precompressed
