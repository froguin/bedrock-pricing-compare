# bedrock-compare.awskr.net -- existing distribution E1OQXWKSFOXAF is replaced by this stack
# (plan + web ACL + code-managed distribution). The bucket stays where it is (ap-northeast-2);
# its bucket policy and the existing deploy role are updated by hand, see aws-whats-new-korean/infra/README.md.
# Phase 1: AttachAlias=false. Phase 2 (cutover): move the alias with associate-alias, then AttachAlias=true.
StackName=awskr-site-bedrock-compare
SiteName=bedrock-compare
DomainName=bedrock-compare.awskr.net
AttachAlias=false
ManageDnsRecords=false
CreateBucket=false
BucketName=awskr-bedrock-pricing
BucketRegion=ap-northeast-2
UrlMode=precompressed
